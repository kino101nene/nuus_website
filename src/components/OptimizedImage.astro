---
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
  fetchpriority?: 'high' | 'low' | 'auto';
  width?: number;
  widths?: number[];
  sizes?: string;
}

const { src, alt, loading = 'lazy', class: className, fetchpriority, width, widths, sizes } = Astro.props;
---

<Image src={src} alt={alt} loading={loading} class={className} fetchpriority={fetchpriority} width={width} widths={widths} sizes={sizes} />
