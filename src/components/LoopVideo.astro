---
interface Props {
  src: string;
  poster: string;
  alt: string;
  class?: string;
  scrollControlled?: boolean;
}

const { src, poster, alt, class: className, scrollControlled = false } = Astro.props;
---

<video
  class={className}
  src={src}
  poster={poster}
  muted
  loop
  playsinline
  preload="none"
  aria-label={alt || undefined}
  aria-hidden={alt ? undefined : "true"}
  data-managed-loop-video={!scrollControlled ? "" : undefined}
  data-scroll-controlled={scrollControlled ? "" : undefined}
></video>

<script>
  import "../scripts/managed-loop-video";
</script>
