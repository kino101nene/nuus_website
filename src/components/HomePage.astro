---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptimizedImage from "./OptimizedImage.astro";
import LoopVideo from "./LoopVideo.astro";
import { homeCopy } from "../i18n/home";
import { getPageHref, type Locale } from "../i18n/routes";
import optimizedHomeVideo from "../assets/media/loops/home-nuus-sum.mp4";
import heroPoster from "../assets/home/hero-image-mobile.webp";
import realCopy from "../assets/real-copy/thumbnails/IMG_8366 (1).JPG";
import jijitsu from "../assets/jijitsu/thumbnails/IMG_3734.jpg";
import rabbit from "../assets/rabbit/thumbnails/scene8_5_bed.jpg";
import whenThumbnail from "../assets/when/IMG_3878.JPG";
import "../styles/home.css";

const { locale } = Astro.props as { locale: Locale };
const copy = homeCopy[locale];
const realCopyHref = getPageHref(locale, "realCopy");
const jijitsuHref = getPageHref(locale, "jijitsu");
const rabbitHref = getPageHref(locale, "rabbit");
---

<BaseLayout bodyClass="home-page" title={copy.title} description={copy.description} current="home" locale={locale} alternatePath="">
  <section class="home-hero" aria-label={copy.heroLabel}>
    <div class="home-hero-sticky">
      <LoopVideo class="home-film" src={optimizedHomeVideo} poster={heroPoster.src} alt={copy.heroVideoAlt} />
    </div>
    <a class="home-hero-scroll-link" href="#home-work" aria-label={copy.scrollLabel}>
      <svg class="home-hero-scroll-arrow" viewBox="0 0 511.93 511.93" aria-hidden="true"><path fill="currentColor" d="M476.738 280.436c-4.16-4.16-10.88-4.16-15.04 0l-195.2 195.2V10.996c0-5.333-3.84-10.133-9.067-10.88-6.613-.96-12.267 4.16-12.267 10.56v464.96l-195.093-195.2c-4.267-4.053-10.987-3.947-15.04.213-3.947 4.16-3.947 10.667 0 14.827L248.365 508.81c4.16 4.16 10.88 4.16 15.04 0l213.333-213.333c4.16-4.054 4.16-10.881 0-15.041Z" /></svg>
    </a>
  </section>

  <div class="home-editorial">
    <section class="home-work" id="home-work" aria-label={copy.selectedWorkLabel}>
      <div class="home-work-grid">
        <article class="home-project">
          <a class="home-project-image" href={realCopyHref} aria-label={copy.realCopyLinkLabel}><OptimizedImage src={realCopy} alt={copy.realCopyImageAlt} /></a>
          <div class="home-project-content">
            <span class="home-label">{copy.exhibitionLabel}</span>
            <h3><a href={realCopyHref}>REAL_copy</a></h3>
            <a class="home-project-link" href={realCopyHref}>
              <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M200 64v104a8 8 0 0 1-16 0V83.314L69.657 197.657a8 8 0 0 1-11.314-11.314L172.686 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z" /></svg>
              <span>{copy.viewMore}</span>
            </a>
          </div>
        </article>
        <article class="home-project">
          <div class="home-project-content">
            <span class="home-label">{copy.exhibitionLabel}</span>
            <h3><a href={jijitsuHref} hreflang={locale}>jijitsu</a></h3>
            <a class="home-project-link" href={jijitsuHref} hreflang={locale}>
              <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M200 64v104a8 8 0 0 1-16 0V83.314L69.657 197.657a8 8 0 0 1-11.314-11.314L172.686 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z" /></svg>
              <span>{copy.viewMore}</span>
            </a>
          </div>
          <a class="home-project-image" href={jijitsuHref} hreflang={locale} aria-label={copy.jijitsuLinkLabel}><OptimizedImage src={jijitsu} alt={copy.jijitsuImageAlt} /></a>
        </article>
      </div>
      <div class="home-work-grid">
      <article class="home-project home-project--rabbit">
          <a class="home-project-image" href={rabbitHref} hreflang={locale} aria-label={copy.rabbitLinkLabel}><OptimizedImage src={rabbit} alt={copy.rabbitImageAlt} /></a>
        <div class="home-project-content">
          <span class="home-label">{copy.mediaArtLabel}</span>
          <h3><a href={rabbitHref} hreflang={locale}>rabbit, habbit, kubid</a></h3>
        </div>
      </article>
      <article class="home-project" id="home-video-game" aria-label={copy.comingSoonLabel}>
        <div class="home-project-image" aria-hidden="true"><OptimizedImage src={whenThumbnail} alt="" /></div>
        <div class="home-project-content">
          <span class="home-label">{copy.videoGameLabel}</span>
          <h3>{copy.comingSoon}</h3>
        </div>
      </article>
      </div>
    </section>

  </div>
</BaseLayout>
