---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getPageHref, type Locale } from "../i18n/routes";

const { pathname } = Astro.url;
const { locale = "ja", alternatePath } = Astro.props as { locale?: Locale; alternatePath?: string };
const links = [
  { href: getPageHref(locale, "home", "home-work"), en: "What was", ja: "具現化したアイデア" },
  { href: getPageHref(locale, "who"), en: "Who is", ja: "脳" },
  { href: getPageHref(locale, "home", "home-video-game"), en: "When will be", ja: "今考えてること" },
];
const active = (href: string) => href.endsWith("#home-work")
  ? pathname.startsWith("/what/") || pathname.startsWith("/en/what/")
  : pathname.replace(/\/$/, "") === href.replace(/\/$/, "");
---
<header class="site-header">
  <div class="header-inner">
    <a href={getPageHref(locale, "home")} class="logo-link" aria-label={locale === "ja" ? "Nuus ホーム" : "Nuus home"}>
      <span class="logo" aria-hidden="true">
        <img class="logo-image" src="/assets/header/nuus_logo_bl.svg" alt="" />
        <img class="logo-image logo-image--first" src="/assets/header/nuus_logo_bl.svg" alt="" />
      </span>
    </a>
    <nav class="desktop-nav" aria-label={locale === "ja" ? "メインナビゲーション" : "Primary navigation"}>
      {links.map(link => (
        <a class="nav-item" href={link.href} aria-current={active(link.href) ? "page" : undefined}>
          <span class="nav-en">{link.en}</span><span class="nav-ja" lang="ja">{link.ja}</span>
        </a>
      ))}
      {alternatePath !== undefined && <LanguageSwitcher locale={locale} path={alternatePath} />}
    </nav>
    <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">Menu <span aria-hidden="true">+</span></button>
    <nav id="mobile-navigation" class="mobile-menu-panel" aria-label={locale === "ja" ? "モバイルナビゲーション" : "Mobile navigation"} hidden>
      {links.map(link => (
        <a class="nav-item" href={link.href} aria-current={active(link.href) ? "page" : undefined}>
          <span class="nav-en">{link.en}</span><span class="nav-ja" lang="ja">{link.ja}</span>
        </a>
      ))}
      {alternatePath !== undefined && <LanguageSwitcher locale={locale} path={alternatePath} />}
    </nav>
  </div>
</header>
