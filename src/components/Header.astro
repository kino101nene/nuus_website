---
const { pathname } = Astro.url;
const links = [
  { href: "/#home-work", en: "What was", ja: "具現化したアイデア" },
  { href: "/who", en: "Who is", ja: "脳" },
  { href: "/#home-video-game", en: "When will be", ja: "今考えてること" },
];
const active = (href: string) => href === "/#home-work"
  ? pathname.startsWith("/what/")
  : pathname === href || pathname.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link" aria-label="Nuus home">
      <svg class="logo" viewBox="0 0 3397 1008" role="img" aria-label="Nuus">
        <use class="logo-glyph" href="/assets/header/nuus_logo_bl.svg#glyph-n" />
        <use class="logo-glyph logo-glyph--secondary" href="/assets/header/nuus_logo_bl.svg#glyph-u1" />
        <use class="logo-glyph logo-glyph--secondary" href="/assets/header/nuus_logo_bl.svg#glyph-u2" />
        <use class="logo-glyph logo-glyph--secondary" href="/assets/header/nuus_logo_bl.svg#glyph-s" />
      </svg>
    </a>
    <nav class="desktop-nav" aria-label="Primary">
      {links.map(link => (
        <a class="nav-item" href={link.href} aria-current={active(link.href) ? "page" : undefined}>
          <span class="nav-en">{link.en}</span><span class="nav-ja" lang="ja">{link.ja}</span>
        </a>
      ))}
    </nav>
    <button class="mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation">Menu <span aria-hidden="true">+</span></button>
    <nav id="mobile-navigation" class="mobile-menu-panel" aria-label="Mobile primary" hidden>
      {links.map(link => (
        <a class="nav-item" href={link.href} aria-current={active(link.href) ? "page" : undefined}>
          <span class="nav-en">{link.en}</span><span class="nav-ja" lang="ja">{link.ja}</span>
        </a>
      ))}
    </nav>
  </div>
</header>
