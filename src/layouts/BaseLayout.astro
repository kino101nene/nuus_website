---
import Header from "../components/Header.astro";
import Analytics from "@vercel/analytics/astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPageHref, type Locale } from "../i18n/routes";
import { socialImages } from "../i18n/social";

import "../styles/main.css";
import "../styles/DesktopNav.css";
import "../styles/MobileNav.css";

const {
  title = "Nuus",
  description = "",
  current = "",
  alternatePath
} = Astro.props;
const locale = (Astro.props.locale ?? Astro.currentLocale ?? "ja") as Locale;
const siteOrigin = Astro.site?.origin;
const canonical = siteOrigin ? new URL(Astro.url.pathname, siteOrigin).href : Astro.url.pathname;
const socialImage = alternatePath === undefined ? undefined : socialImages[alternatePath];
const socialImageUrl = socialImage && siteOrigin ? new URL(socialImage.path, siteOrigin).href : undefined;
const alternates = alternatePath !== undefined
  ? (["ja", "en"] as const).map((language) => ({
      language,
      href: siteOrigin
        ? new URL(getRelativeLocaleUrl(language, alternatePath), siteOrigin).href
        : getRelativeLocaleUrl(language, alternatePath)
    }))
  : [];
const homepageStructuredData = current === "home" && siteOrigin
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${siteOrigin}/#website`,
          url: `${siteOrigin}/`,
          name: "Nuus",
          publisher: { "@id": `${siteOrigin}/#organization` },
          inLanguage: ["ja", "en"]
        },
        {
          "@type": "Organization",
          "@id": `${siteOrigin}/#organization`,
          name: "Nuus",
          url: `${siteOrigin}/`,
          logo: `${siteOrigin}/assets/header/nuus_logo_bl.svg`,
          sameAs: ["https://www.instagram.com/nuus___/"]
        }
      ]
    }).replace(/</g, "\\u003c")
  : undefined;
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-circle.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:locale" content={locale === "ja" ? "ja_JP" : "en_US"} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Nuus" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:type" content="image/jpeg" />}
    {socialImageUrl && <meta property="og:image:width" content="1200" />}
    {socialImageUrl && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content={socialImage.alt[locale]} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImage && <meta name="twitter:image:alt" content={socialImage.alt[locale]} />}
    <link rel="canonical" href={canonical} />
    {alternates.map(({ language, href }) => <link rel="alternate" hreflang={language} href={href} />)}
    {alternatePath !== undefined && <meta property="og:locale:alternate" content={locale === "ja" ? "en_US" : "ja_JP"} />}
    {homepageStructuredData && <script type="application/ld+json" set:html={homepageStructuredData} />}
  </head>

  <body class={Astro.props.bodyClass}>
    <Header current={current} locale={locale} alternatePath={alternatePath} />

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <a class="footer-brand" href={getPageHref(locale, "home")} aria-label={locale === "ja" ? "NUUS ホーム" : "NUUS home"}><img src="/assets/header/nuus_logo_bl.svg" alt="NUUS" /></a>
        <nav class="footer-socials" aria-label="Contact links">
          <a href="mailto:hello@nuus-official.com">email</a>
          <a href="https://www.instagram.com/nuus___/" target="_blank" rel="noopener noreferrer">instagram</a>
        </nav>
      </div>
    </footer>

    <script src="/js/main.js" defer></script>
    <Analytics />
  </body>
</html>
