---
import Header from "../components/Header.astro";
import Analytics from "@vercel/analytics/astro";

import "../styles/main.css";
import "../styles/DesktopNav.css";
import "../styles/MobileNav.css";

const {
  title = "Nuus",
  description = "",
  current = ""
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
  </head>

  <body class={Astro.props.bodyClass}>
    <Header current={current} />

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <a class="footer-brand" href="/" aria-label="NUUS home"><img src="/assets/header/nuus_logo_bl.svg" alt="NUUS" /></a>
        <nav class="footer-socials" aria-label="Contact links">
          <a href="https://www.instagram.com/nuus___/" target="_blank" rel="noopener noreferrer">instagram</a>
        </nav>
      </div>
    </footer>

    <script src="/js/main.js" defer></script>
    <Analytics />
  </body>
</html>
