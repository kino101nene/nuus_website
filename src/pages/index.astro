---
import BaseLayout from "../layouts/BaseLayout.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import LoopVideo from "../components/LoopVideo.astro";
import optimizedHomeVideo from "../assets/media/loops/home-nuus-sum.mp4";
import heroPoster from "../assets/home/hero-image-mobile.webp";
import realCopy from "../assets/real-copy/thumbnails/IMG_8366 (1).JPG";
import jijitsu from "../assets/jijitsu/thumbnails/IMG_3734.jpg";
import rabbit from "../assets/rabbit/thumbnails/scene8_5_bed.jpg";
import whenThumbnail from "../assets/when/IMG_3878.JPG";
import "../styles/home.css";
---
<BaseLayout bodyClass="home-page" title="Nuus" description="本質と現象にN軸をもって作品を作るクリエイティブ集団、Nuus。" current="home">
  <section class="home-hero" aria-label="Nuus introduction">
    <div class="home-hero-sticky">
      <LoopVideo class="home-film" src={optimizedHomeVideo} poster={heroPoster.src} alt="Nuusのイントロ映像" />
    </div>
    <a class="home-hero-scroll-link" href="#home-work" aria-label="Selected workへ移動">
      <svg class="home-hero-scroll-arrow" viewBox="0 0 511.93 511.93" aria-hidden="true"><path fill="currentColor" d="M476.738 280.436c-4.16-4.16-10.88-4.16-15.04 0l-195.2 195.2V10.996c0-5.333-3.84-10.133-9.067-10.88-6.613-.96-12.267 4.16-12.267 10.56v464.96l-195.093-195.2c-4.267-4.053-10.987-3.947-15.04.213-3.947 4.16-3.947 10.667 0 14.827L248.365 508.81c4.16 4.16 10.88 4.16 15.04 0l213.333-213.333c4.16-4.054 4.16-10.881 0-15.041Z" /></svg>
    </a>
  </section>

  <div class="home-editorial">
    <section class="home-work" id="home-work" aria-label="Selected work">
      <div class="home-work-grid">
        <article class="home-project">
          <a class="home-project-image" href="/what/real-copy" aria-label="REAL_copyの詳細を見る"><OptimizedImage src={realCopy} alt="REAL_copy — project documentation" /></a>
          <div class="home-project-content">
            <span class="home-label">EXHIBTION</span>
            <h3><a href="/what/real-copy">REAL_copy</a></h3>
            <a class="home-project-link" href="/what/real-copy">
              <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M200 64v104a8 8 0 0 1-16 0V83.314L69.657 197.657a8 8 0 0 1-11.314-11.314L172.686 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z" /></svg>
              <span>View more</span>
            </a>
          </div>
        </article>
        <article class="home-project">
          <div class="home-project-content">
            <span class="home-label">EXHIBTION</span>
            <h3><a href="/what/jijitsu">jijitsu</a></h3>
            <a class="home-project-link" href="/what/jijitsu">
              <svg width="24" height="24" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M200 64v104a8 8 0 0 1-16 0V83.314L69.657 197.657a8 8 0 0 1-11.314-11.314L172.686 72H88a8 8 0 0 1 0-16h104a8 8 0 0 1 8 8Z" /></svg>
              <span>View more</span>
            </a>
          </div>
          <a class="home-project-image" href="/what/jijitsu" aria-label="jijitsuの詳細を見る"><OptimizedImage src={jijitsu} alt="jijitsu — exhibition documentation" /></a>
        </article>
      </div>
      <div class="home-work-grid">
      <article class="home-project home-project--rabbit">
          <a class="home-project-image" href="/what/rabbit" aria-label="rabbit, habbit, kubidの詳細を見る"><OptimizedImage src={rabbit} alt="rabbit, habbit, kubid — film still" /></a>
        <div class="home-project-content">
          <span class="home-label">MEDIA ART</span>
          <h3><a href="/what/rabbit">rabbit, habbit, kubid</a></h3>
        </div>
      </article>
      <article class="home-project" id="home-video-game" aria-label="Video Game project coming soon">
        <div class="home-project-image" aria-hidden="true"><OptimizedImage src={whenThumbnail} alt="" /></div>
        <div class="home-project-content">
          <span class="home-label">VIDEO GAME</span>
          <h3>Coming soon</h3>
        </div>
      </article>
      </div>
    </section>

  </div>
</BaseLayout>
