---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/when.css";
const entries = [
  { period: "Now", label: "COLLABORATIONS", title: "Open to possibilities.", text: "Open to freelance / collaborations. Based in Amsterdam / NL.", current: true },
  { period: "2025–2026", label: "FOCUS", title: "Web & interaction.", text: "Major focus: shipping polished web + interaction projects, portfolio consolidation.", current: false },
  { period: "Earlier", label: "EXPLORATIONS", title: "Body, technology & play.", text: "Experimental work exploring body + tech, gestures, control, and play.", current: false },
];
---
<BaseLayout bodyClass="when-page" title="When — Nuus" description="Nuusの現在の関心と活動の記録。" current="when">
  <article class="when-editorial" aria-labelledby="when-title">
    <header class="when-intro">
      <div class="when-eyebrow"><span>NUUS / NOTES IN TIME</span><span>PAST / PRESENT</span></div>
      <div class="when-heading"><h1 id="when-title">When<span>.</span></h1><div><p lang="ja">今考えてること</p><p>Current interests &amp; ongoing explorations.</p></div></div>
    </header>
    <ol class="when-timeline" aria-label="Activity timeline, latest first">
      {entries.map((entry, index) => (
        <li class:list={["when-entry", { "when-entry-current": entry.current }]}>
          <div class="when-period"><span class="when-dot" aria-hidden="true"></span><span>{entry.period}</span></div>
          <section class="when-entry-content" aria-labelledby={`when-entry-${index}`}>
            <span class="when-label">{entry.label}</span>
            <h2 id={`when-entry-${index}`}>{entry.title}</h2>
            <p>{entry.text}</p>
          </section>
          <span class="when-number" aria-hidden="true">0{index + 1}</span>
        </li>
      ))}
    </ol>
    <a class="when-next" href="/what"><span class="when-label">具現化したアイデア / SELECTED WORK</span><span>Explore the work</span></a>
  </article>
</BaseLayout>
