---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import LoopVideo from "../../components/LoopVideo.astro";
// @ts-ignore
import nuusDiagram from "../../assets/who/nuus_diagram.png";
// @ts-ignore
import seiyaIcon from "../../assets/who/profiles/seiya-icon.JPG";
// @ts-ignore
import aiIcon from "../../assets/media/loops/who-ai-icon.mp4";
import aiIconPoster from "../../assets/media/posters/who-ai-icon.jpg";
// @ts-ignore
import neneIcon from "../../assets/who/profiles/nene-icon.JPG";
import "../../styles/who.css";
---

<BaseLayout bodyClass="who-page" title="Who — Nuus" description="本質と現象にN軸をもって作品を作るクリエイティブ集団、Nuus。" current="who">
  <article class="who-editorial" aria-labelledby="who-title">
    <header class="who-intro">
      <h1 id="who-title">The brains behind</h1>
    </header>

    <section class="who-members" aria-label="Members">
      <div class="who-member-grid">
        {[{image: seiyaIcon, name: "Seiya", role: "management"}, {video: aiIcon, poster: aiIconPoster.src, name: "Ai", role: "art director/creative"}, {image: neneIcon, name: "nene", role: "creative technologist"}].map((member) => (
          <figure>
            <div class="who-member-visual">{member.video ? <LoopVideo src={member.video} poster={member.poster} alt={member.name} /> : member.image && <OptimizedImage src={member.image} alt={member.name} />}<span class="who-member-role">{member.role}</span></div>
            <figcaption><span>{member.name}</span></figcaption>
          </figure>
        ))}
      </div>
      <button class="who-member-arrow who-member-arrow--prev" type="button" aria-label="Previous member" hidden>
        <img src="/assets/arrow-next.svg" alt="" aria-hidden="true" />
      </button>
      <button class="who-member-arrow who-member-arrow--next" type="button" aria-label="Next member">
        <img src="/assets/arrow-next.svg" alt="" aria-hidden="true" />
      </button>
    </section>

  <div class="who-statement project-soft-reveal project-soft-reveal--body" lang="ja">
  <h2 class="who-statement-title" lang="en">The thinking behind</h2>
  <p>
    nuus（ヌース）は、すべてが説明されたかのような世界で、本質と現象を<span class="who-statement-emphasis">N軸</span>から捉える。<br>
    パラレルワールドのような空間や体験をつくり、世界に良い混乱を与える。
  </p>
</div>
    <section class="who-perspective" aria-label="Perspective diagram">
      <OptimizedImage src={nuusDiagram} alt="Nuusの本質（X軸）、現象（Y軸）、N軸を表す図" />
    </section>
  </article>
</BaseLayout>

<script>
  import "../../scripts/soft-reveal";
  import "../../scripts/who-member-carousel";
</script>
