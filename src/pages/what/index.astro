---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import realCopyImage from "../../assets/real-copy/thumbnails/IMG_8348.JPG";
import jijitsuImage from "../../assets/jijitsu/thumbnails/IMG_3734.jpg";
import rabbitImage from "../../assets/rabbit/thumbnails/scene8_5_bed.jpg";
import "../../styles/what.css";

const projects = [
  {
    number: "01", title: "Real_copy", href: "/what/real-copy",
    image: realCopyImage, alt: "Real_copy installation documentation",
    category: "VR / Installation",
    description: "VRと会場を一体化させた今までにない体験型展示",
  },
  {
    number: "02", title: "JIJITSU", href: "/what/jijitsu",
    image: jijitsuImage, alt: "JIJITSU exhibition documentation",
    category: "Exhibition / Installation",
    description: "「USAGIの住処」という名の展示会場で来場者に遊んでもらうことを目的とした展示会",
  },
  {
    number: "03", title: "rabbit,habit,kubid", href: "/what/rabbit",
    image: rabbitImage, alt: "Still from rabbit,habit,kubid",
    category: "Film / Documentary",
    description: "展示会JIJITSUのドキュメンタリー映像と自主制作映像",
  },
];
---

<BaseLayout bodyClass="work-index" title="What — Nuus" description="Selected installations, exhibitions and films by Nuus." current="what">
  <section class="work-collection" aria-labelledby="work-heading">
    <header class="work-intro">
      <div class="work-eyebrow"><span>NUUS / SELECTED WORK</span><span>01 — 03</span></div>
      <div class="work-heading-row">
        <h1 id="work-heading">What<span>.</span></h1>
        <div class="work-intro-copy">
          <p lang="ja">具現化したアイデア</p>
          <p>Installation, exhibition &amp; film.</p>
        </div>
      </div>
    </header>

    <div class="work-list">
      {projects.map((project, index) => (
        <article class="work-entry">
          <a class="work-entry-link" href={project.href} aria-labelledby={`work-title-${index}`}>
            <div class="work-image">
              <OptimizedImage src={project.image} alt={project.alt} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} />
              <span class="work-image-label" aria-hidden="true">Explore project</span>
            </div>
            <div class="work-caption">
              <span class="work-number">/{project.number}</span>
              <div class="work-title-group">
                <h2 id={`work-title-${index}`}>{project.title}</h2>
                <p class="work-category">{project.category}</p>
              </div>
              <p class="work-description" lang="ja">{project.description}</p>
            </div>
          </a>
        </article>
      ))}
    </div>
    <div class="work-end"><span>NUUS — SELECTED WORK</span><a href="/who">Meet the minds behind the work</a></div>
  </section>
  <script src="/js/what.js?v=reveal-3" defer></script>
</BaseLayout>
