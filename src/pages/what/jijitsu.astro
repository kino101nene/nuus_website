---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";

// @ts-ignore
import boxingImg from "../../assets/jijitsu/contents/ciriminal-posters/boxing.jpg";
// @ts-ignore
import galleryImg from "../../assets/jijitsu/contents/ciriminal-posters/gallery.jpg";
// @ts-ignore
import hiringImg from "../../assets/jijitsu/contents/ciriminal-posters/hiring.jpg";
// @ts-ignore
import jazzConcertImg from "../../assets/jijitsu/contents/ciriminal-posters/jazz-concert.jpg";
// @ts-ignore
import margotImg from "../../assets/jijitsu/contents/ciriminal-posters/margot.jpg";
// @ts-ignore
import mathTutorImg from "../../assets/jijitsu/contents/ciriminal-posters/math-tutor.jpg";
// @ts-ignore
import partyImg from "../../assets/jijitsu/contents/ciriminal-posters/party.jpg";
// @ts-ignore
import shopliftersImg from "../../assets/jijitsu/contents/ciriminal-posters/shoplifters.jpg";
// @ts-ignore
import missingImg from "../../assets/jijitsu/contents/ciriminal-posters/missing.jpg";

// @ts-ignore
import lettersImg from "../../assets/jijitsu/contents/dream-mapping/letters.jpg";
// @ts-ignore
import mapImg from "../../assets/jijitsu/contents/dream-mapping/map.jpg";
// @ts-ignore
import orangeDogImg from "../../assets/jijitsu/contents/dream-mapping/orange-dog.JPG";
// @ts-ignore
import soilImg from "../../assets/jijitsu/contents/dream-mapping/soil.jpg";

// @ts-ignore
import visitorGif from "../../assets/jijitsu/contents/room/GIF/visitor1.gif";
import visitorGif2 from "../../assets/jijitsu/contents/room/GIF/visitor2.gif";
import visitorGif3 from "../../assets/jijitsu/contents/room/GIF/visitor3.gif";
import visitorGif4 from "../../assets/jijitsu/contents/room/GIF/visitor4.gif";
// @ts-ignore
import thumbnailImg from "../../assets/jijitsu/thumbnails/IMG_3734.jpg";

import "../../styles/projects/jijitsu-editorial.css";
import roomImage from "../../assets/jijitsu/contents/room/JPG/whole-room.JPG";

const title = "JIJITSU";

const jijitsuMeta = [
  { label: "Year", value: "2026" },
  { label: "Type", value: "Installation / Prototype" },
  { label: "Role", value: "Concept, Dev, Design" },
];

const jijitsuDescriptions = [
  {
    label: "体験",
    text: `このこじんまりとした空間には、キッチン、トイレ、ロフトが備わり、一見すると誰でも住めそうなアパートの一室のように見える。
しかし、部屋の半分には白い布で覆われた土台のようなものが佇み、まず座る場所が見当たらない。
床には土ごと置かれた植物、牛乳らしきものが入った瓶、彫刻のように形作られた粘土が点在し、生活感がありながらも、どこか異様な気配が漂う。`,
  },
  {
    label: "展開",
    text: `来場者には、「かつてUSAGIたちという存在が住処としていたとされる空間の痕跡」が再構築されたものであると説明される。

そして、こう問いかけられる。

「もし、あなたがここに住むとしたら？ ここを自分なりに快適に過ごすとしたら、何をするか？」

USAGIたちが残した"らしき"ものの用途や意味は明かされず、それらはただ、そこにある。`,
  },
  {
    label: "コンセプト",
    text: `来場者は、その空間にあるものを観察し、触れ、試しながら、自分なりの解釈や物語を生み出していく。

ここにあるものは、かつて存在したものなのか、それとも今ここで生まれたものなのか。
その答えを決めるのは、ここにいる一人ひとりの視点と体験である。

フィクションとは、再構築された現実であり、そこに触れることで生まれる新たな認識こそが、自分自身の「自実（Self-reality）」となる。`,
  },
];

const criminalPoster = [
  boxingImg,
  galleryImg,
  hiringImg,
  jazzConcertImg,
  margotImg,
  mathTutorImg,
  partyImg,
  shopliftersImg,
  missingImg,
];

const dreamMapping = [lettersImg, mapImg, orangeDogImg, soilImg];
const roomGifs = [visitorGif, visitorGif2, visitorGif3, visitorGif4];
const sections = [
  {
    number: "02",
    title: "JIJITSU",
    media: visitorGif,
    mediaAlt: "Jijitsu animation",
    meta: jijitsuMeta,
    descriptions: jijitsuDescriptions,
    gallery: [],
  },
  {
    number: "02-01",
    title: "Wanted Criminals",
    media: null,
    mediaAlt: "",
    meta: [],
    titleInContent: true,
    descriptions: [
      {
        label: "概要",
        text: `「Wanted Criminals」 は、指名手配写真のもつフィクション性を再解釈し、デジタル処理を施して新たな文脈に置き換えたポスターシリーズである。

本作では、犯罪者の「像」として機能する指名手配写真をデータとして分解し、ランダムな改変を加えることで、視覚的な明確さを揺るがし、写真が持つ意味や役割を変容させている。

こうして再構築されたポスターは、求人広告やプロモーションビジュアルといった異なるフォーマットへと組み替えられ、元の写真が持っていた機能や権威を逸脱していく。

情報がどのように操作され、異なる文脈の中で受容されるのか——本作は、視覚的な信頼性とその流動性を探る試みである。`,
      },
    ],
    gallery: [
      { src: boxingImg, title: "Boxing" },
      { src: galleryImg, title: "Gallery" },
      { src: hiringImg, title: "Hiring" },
      { src: jazzConcertImg, title: "Jazz Concert" },
      { src: margotImg, title: "Margot" },
      { src: mathTutorImg, title: "Math Tutor" },
      { src: partyImg, title: "Party" },
      { src: shopliftersImg, title: "Shoplifters" },
      { src: missingImg, title: "Missing" },
    ],
  },
  {
    number: "02-02",
    title: "Dream Mapping",
    media: mapImg,
    mediaAlt: "Dream Mapping main image",
    meta: [],
    titleInContent: true,
    descriptions: [
      {
        label: "概要",
        text: `USAGIたちが記録していたとされる「夢の地図」。それは言葉と図形が交錯し、論理的な説明を拒む断片的な記録である。

ここに描かれているのは、場所なのか、記憶なのか、それとも誰かの想像の産物なのか。見る者は、その解釈を委ねられ、自らの物語を紡ぐことになる。

夢とは、語られることで形を成し、共有されることで新たな意味を持つ——「Dream Mapping」は、その流動性を可視化する試みである。`,
      },
    ],
    gallery: dreamMapping.map((src, index) => ({
      src,
      title: `Dream Mapping ${index + 1}`,
    })),
  },
];
---

<BaseLayout bodyClass="jijitsu-page" title={`${title} — Nuus`} description="USAGIたちの住処を辿る体験型展示、JIJITSU。" current="what">
  <article class="jj-project" aria-labelledby="jj-title">
    <header class="jj-intro">
      <div class="jj-eyebrow"><span>#2 YEAR 2026, TOKYO</span></div>
      <div class="jj-title-row">
        <h1 id="jj-title">JIJITSU</h1>
        <div class="jj-title-experience">
          <div class="jj-prose">
            <p>{jijitsuDescriptions[0].text.replace(/\s+/g, "").split("床には")[0]}</p>
            <p>床には{jijitsuDescriptions[0].text.replace(/\s+/g, "").split("床には")[1]}</p>
          </div>
        </div>
      </div>
    </header>

    <figure class="jj-room">
      <OptimizedImage src={roomImage} alt="JIJITSUの展示空間の全景" loading="eager" fetchpriority="high" />
      <figcaption><span>USAGIたちの住処</span><span>INSTALLATION VIEW</span></figcaption>
    </figure>
    <div class="jj-room-gifs" aria-label="JIJITSU visitor records">
      {roomGifs.map((gif, index) => <figure><OptimizedImage src={gif} alt={`JIJITSU visitor record ${index + 1}`} /><figcaption><span>VISITOR RECORD</span><span>0{index + 1}</span></figcaption></figure>)}
    </div>

    <section class="jj-encounter" aria-labelledby="jj-question">
      <div class="jj-question-copy" lang="ja">
        <span class="jj-label">02 / AN INVITATION</span>
        <h2 id="jj-question">もし、あなたが<br />ここに住むとしたら？</h2>
        <p>ここを自分なりに快適に過ごすとしたら、何をするか？</p>
      </div>
    </section>
    <section class="jj-text" aria-labelledby="jj-development" lang="ja">
      <h2 id="jj-development"><span>THE ENCOUNTER</span>展開</h2>
      <div class="jj-prose">{jijitsuDescriptions[1].text.split("\n\n").filter(Boolean).map(text => <p>{text}</p>)}</div>
    </section>

    <section class="jj-chapter" aria-labelledby="jj-posters">
      <header class="jj-chapter-heading"><span class="jj-label">03 / TRACES</span><h2 id="jj-posters">Wanted Criminals</h2></header>
      <div class="jj-chapter-description jj-prose" lang="ja">{sections[1].descriptions[0].text.split("\n\n").map(text => <p>{text}</p>)}</div>
      <div class="jj-posters">
        {sections[1].gallery.map((item, index) => <figure><OptimizedImage src={item.src} alt={`Wanted Criminals — ${item.title}`} /><figcaption><span>{item.title}</span><span>0{index + 1}</span></figcaption></figure>)}
      </div>
    </section>

    <section class="jj-chapter" aria-labelledby="jj-dream">
      <header class="jj-chapter-heading"><span class="jj-label">04 / RECORDS</span><h2 id="jj-dream">Dream Mapping</h2></header>
      <div class="jj-chapter-description jj-prose" lang="ja">{sections[2].descriptions[0].text.split("\n\n").map(text => <p>{text}</p>)}</div>
      <figure class="jj-map"><OptimizedImage src={mapImg} alt="USAGIたちの夢の地図" /><figcaption><span>Dream map</span><span>01 / 04</span></figcaption></figure>
      <div class="jj-records">
        {[{ src: lettersImg, title: "Letters" }, { src: orangeDogImg, title: "Orange dog" }, { src: soilImg, title: "Soil" }].map((item, index) => <figure><OptimizedImage src={item.src} alt={`Dream Mapping — ${item.title}`} /><figcaption><span>{item.title}</span><span>0{index + 2} / 04</span></figcaption></figure>)}
      </div>
    </section>

    <section class="jj-text jj-concept" aria-labelledby="jj-concept" lang="ja">
      <h2 id="jj-concept"><span>05 / SELF-REALITY</span>コンセプト</h2>
      <div class="jj-prose">{jijitsuDescriptions[2].text.split("\n\n").filter(Boolean).map(text => <p>{text}</p>)}</div>
    </section>
    <a class="jj-next" href="/what/rabbit"><span class="jj-label">次の作品 / NEXT PROJECT</span><span class="jj-next-title">rabbit,habit,kubid</span></a>
  </article>
</BaseLayout>

<script>
  const project = document.querySelector('.jj-project');
  const intro = document.querySelector('.jj-intro');
  const room = document.querySelector('.jj-room');
  const gifs = document.querySelector('.jj-room-gifs');
  const syncRoomSpacing = () => {
    if (!intro || !room || !gifs) return;
    const roomHeight = room.getBoundingClientRect().height;
    const introHeight = intro.getBoundingClientRect().height;
    gifs.style.marginTop = `${Math.max(40, roomHeight - introHeight + 40)}px`;
  };
  window.addEventListener('load', syncRoomSpacing);
  window.addEventListener('resize', syncRoomSpacing);
</script>
