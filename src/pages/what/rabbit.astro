---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";
import ProjectHero from "../../components/ProjectHero.astro";

import "../../styles/projects/rabbit-editorial.css";
import realCopyNext1 from "../../assets/real-copy/contents/IMG_8360.JPG";
import realCopyNext2 from "../../assets/real-copy/contents/IMG_8375.JPG";
import realCopyNext3 from "../../assets/real-copy/contents/IMG_8420.JPG";

// @ts-ignore
import visitor1 from "../../assets/rabbit/visitor1.gif";
// @ts-ignore
import visitor2 from "../../assets/rabbit/visitor2.gif";
// @ts-ignore
import visitor3 from "../../assets/rabbit/visitor3.gif";

// @ts-ignore
import rabbit1 from "../../assets/rabbit/rabbit1.gif";
// @ts-ignore
import rabbit2 from "../../assets/rabbit/rabbit2.gif";
// @ts-ignore
import rabbit3 from "../../assets/rabbit/rabbit3.gif";
// @ts-ignore
import rabbit4 from "../../assets/rabbit/rabbit4.gif";
// @ts-ignore
import rabbit5 from "../../assets/rabbit/rabbit5.gif";
// @ts-ignore
import rabbit6 from "../../assets/rabbit/rabbit6.gif";
// @ts-ignore
import rabbit7 from "../../assets/rabbit/rabbit7.gif";

// @ts-ignore
import rabbitBehind from "../../assets/rabbit/rabbit_behind.png";

const title = "Rabbit, Habbit, Kubid";
const filmGifs = [rabbit1, rabbit2, rabbit3, rabbit4, rabbit5, rabbit6, rabbit7];

const introText = `この空間は、USAGIたちの映画「Rabbit, Habbit, Kubid」に登場する場所であり、彼らの棲家である。`;

---

<BaseLayout bodyClass="rabbit-screening" title={`${title} — Nuus`} description="JIJITSUの来場者と映画の世界が交わる映像作品。" current="what">
  <article class="project-editorial rb-project" aria-label={title}>
    <ProjectHero
      variant="rb"
      titleLines={["Rabbit,", "Habbit, Kubid"]}
      image={rabbit1}
      imageAlt="Rabbit, Habbit, Kubidのループ映像"
      optimizeImage={false}
      year="2023"
      place="TOYAMA"
      credit="AI, nene, Alex"
      paragraphs={[{ before: introText }]}
    />

    <section class="rb-chapter" aria-label="来場者の記録">
      <div class="rb-chapter-gallery">
        <figure><OptimizedImage src={visitor1} alt="JIJITSUの空間を体験する来場者" /></figure>
        <div class="rb-chapter-gallery-bottom">
          <figure><OptimizedImage src={visitor2} alt="来場者の記録 2" /></figure>
          <figure><OptimizedImage src={visitor3} alt="来場者の記録 3" /></figure>
        </div>
      </div>
    </section>

    <section class="project-split project-concept rb-concept-feature" aria-labelledby="rb-concept" lang="ja">
      <h2 id="rb-concept" class="project-soft-reveal project-soft-reveal--title-slow">「見る」存在でありながら、<br>いつの間にか「見られる」存在となる。</h2>
      <div class="project-prose rb-concept-prose project-soft-reveal project-soft-reveal--body">
        <p>うさぎたちにとって、言葉は単なるコミュニケーションではなく、世界そのものを形づくる枠組みである。</p>
        <p>空間、行動、映像の表現がその変化を反映し、<span class="rb-concept-emphasis">言語＝世界の再構築</span>のプロセスが描かれる。</p>
      </div>
    </section>

    <div class="rb-film-wrap">
      <section class="rb-chapter" aria-label="Rabbit, Habbit, Kubid">
        <div class="rb-chapter-gallery rb-chapter-gallery--film">
          <div class="rb-film-frame">
            {filmGifs.map((gif, index) => <figure class:list={{ "is-active": index === 0 }}><img src={gif.src} alt={`Rabbit, Habbit, Kubid — 映像断片 ${index + 1}`} width={gif.width} height={gif.height} loading={index === 0 ? "eager" : "lazy"} /></figure>)}
          </div>
        </div>
      </section>

      <section class="rb-chapter rb-chapter--behind" aria-label="Behind the film"><figure class="rb-behind"><OptimizedImage src={rabbitBehind} alt="Rabbit, Habbit, Kubidの制作風景" /></figure></section>
    </div>
    <div class="project-next">
      <div class="project-next-project-row">
        <div class="project-next-copy">
          <span class="project-next-kicker">他の作品</span>
          <a class="project-next-link" href="/what/real-copy" aria-label="Real Copy プロジェクトを見る">
            <span class="project-next-title">Real_Copy</span>
            <svg class="project-next-arrow" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
              <path fill="currentColor" d="M4 2h6l10 10-10 10H4l10-10L4 2Z" />
            </svg>
          </a>
        </div>
        <div class="project-next-gifs" aria-hidden="true">
          <OptimizedImage src={realCopyNext1} alt="" />
          <OptimizedImage src={realCopyNext2} alt="" />
          <OptimizedImage src={realCopyNext3} alt="" />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import "../../scripts/next-project";
  import "../../scripts/soft-reveal";

  const filmGallery = document.querySelector<HTMLElement>(".rb-chapter-gallery--film");
  const filmFrame = filmGallery?.querySelector<HTMLElement>(".rb-film-frame");
  const filmSlides = filmFrame ? [...filmFrame.querySelectorAll<HTMLElement>("figure")] : [];
  if (filmGallery && filmFrame && filmSlides.length > 1 && window.matchMedia("(max-width: 700px)").matches) {
    const updateFilmSlide = () => {
      const galleryTop = filmGallery.getBoundingClientRect().top + window.scrollY;
      const galleryStyle = getComputedStyle(filmGallery);
      const topPadding = parseFloat(galleryStyle.paddingTop) || 0;
      const stickyTop = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 0;
      const travel = Math.max(1, filmGallery.offsetHeight - filmFrame.offsetHeight - topPadding);
      const progress = Math.min(1, Math.max(0, (window.scrollY - (galleryTop + topPadding - stickyTop)) / travel));
      const activeIndex = Math.min(filmSlides.length - 1, Math.round(progress * (filmSlides.length - 1)));
      filmSlides.forEach((slide, index) => slide.classList.toggle("is-active", index === activeIndex));
    };
    updateFilmSlide();
    window.addEventListener("scroll", updateFilmSlide, { passive: true });
    window.addEventListener("resize", updateFilmSlide, { passive: true });
  }

  const heroProses = [...document.querySelectorAll<HTMLElement>('.rb-hero-prose')];
  if (heroProses.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroProses.forEach((heroProse) => {
      const textNodes = [...heroProse.querySelectorAll('p')].flatMap((element) =>
        [...element.childNodes].filter((node) => node.nodeType === Node.TEXT_NODE && node.textContent)
      );
      textNodes.forEach((node) => {
        const fragment = document.createDocumentFragment();
        [...(node.textContent ?? '')].forEach((character) => {
          const span = document.createElement('span');
          span.className = 'rb-visual-char';
          span.textContent = character;
          fragment.appendChild(span);
        });
        node.replaceWith(fragment);
      });
    });

    const updateVisualLines = () => heroProses.forEach((heroProse) => {
      if (!heroProse.getClientRects().length) return;
      const lineTops: number[] = [];
      heroProse.querySelectorAll<HTMLElement>('.rb-visual-char').forEach((character) => {
        const top = character.getBoundingClientRect().top;
        let lineIndex = lineTops.findIndex((lineTop) => Math.abs(lineTop - top) < 2);
        if (lineIndex === -1) {
          lineIndex = lineTops.length;
          lineTops.push(top);
        }
        const stagger = parseFloat(getComputedStyle(heroProse).getPropertyValue('--project-hero-line-stagger')) || 90;
        character.style.setProperty('--line-delay', `${lineIndex * stagger}ms`);
      });
      heroProse.classList.add('is-line-motion-ready');
    });

    updateVisualLines();
    document.fonts.ready.then(updateVisualLines);
    window.addEventListener('resize', updateVisualLines);
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(({ target, isIntersecting }) => target.classList.toggle('is-in-view', isIntersecting));
    }, { threshold: 0.25 });
    heroProses.forEach((heroProse) => observer.observe(heroProse));
  }
</script>
