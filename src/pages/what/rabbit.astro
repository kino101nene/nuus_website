---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OptimizedImage from "../../components/OptimizedImage.astro";

import "../../styles/projects/rabbit-editorial.css";
import realCopyNext1 from "../../assets/real-copy/contents/IMG_8360.JPG";
import realCopyNext2 from "../../assets/real-copy/contents/IMG_8375.JPG";
import realCopyNext3 from "../../assets/real-copy/contents/IMG_8420.JPG";

// @ts-ignore
import visitor1 from "../../assets/rabbit/visitor1.gif";
// @ts-ignore
import visitor2 from "../../assets/rabbit/visitor2.gif";
// @ts-ignore
import visitor3 from "../../assets/rabbit/visitor3.gif";

// @ts-ignore
import rabbit1 from "../../assets/rabbit/rabbit1.gif";
// @ts-ignore
import rabbit2 from "../../assets/rabbit/rabbit2.gif";
// @ts-ignore
import rabbit3 from "../../assets/rabbit/rabbit3.gif";
// @ts-ignore
import rabbit7 from "../../assets/rabbit/rabbit7.gif";

// @ts-ignore
import rabbitBehind from "../../assets/rabbit/rabbit_behind.png";

const title = "Rabbit, Habbit, Kubid";

const introText = `この空間は、USAGIたちの映画「Rabbit, Habbit, Kubid」に登場する場所であり、彼らの棲家である。`;

---

<BaseLayout bodyClass="rabbit-screening" title={`${title} — Nuus`} description="JIJITSUの来場者と映画の世界が交わる映像作品。" current="what">
  <article class="project-editorial rb-project" aria-labelledby="rb-title">
    <header class="rb-intro">
      <h1 id="rb-title">Rabbit,<br />Habbit, Kubid<span>.</span></h1>
    </header>

    <div class="rb-screen">
      <img src={rabbit1.src} alt="Rabbit, Habbit, Kubidのループ映像" width={rabbit1.width} height={rabbit1.height} loading="eager" fetchpriority="high" />
    </div>
    <section class="project-split rb-hero-details" aria-label="作品情報">
      <div class="project-eyebrow">
        <div class="project-eyebrow-pair"><span class="project-eyebrow-title">YEAR</span><span>2023</span></div>
        <div class="project-eyebrow-pair"><span class="project-eyebrow-title">PLACE</span><span>TOYAMA</span></div>
        <div class="project-eyebrow-pair"><span class="project-eyebrow-title">CREDIT</span><span>AI, nene, Alex</span></div>
      </div>
      <div class="rb-hero-prose" lang="ja"><p>{introText}</p></div>
    </section>

    <section class="rb-chapter" aria-label="来場者の記録">
      <div class="rb-chapter-gallery">
        <figure><OptimizedImage src={visitor1} alt="JIJITSUの空間を体験する来場者" /></figure>
        <div class="rb-chapter-gallery-bottom">
          <figure><OptimizedImage src={visitor2} alt="来場者の記録 2" /></figure>
          <figure><OptimizedImage src={visitor3} alt="来場者の記録 3" /></figure>
        </div>
      </div>
    </section>

    <section class="project-split project-concept rb-concept-feature" aria-labelledby="rb-concept" lang="ja">
      <h2 id="rb-concept" class="rb-soft-reveal">「見る」存在でありながら、<br>いつの間にか「見られる」存在となる。</h2>
      <div class="project-prose rb-concept-prose">
        <p>うさぎたちにとって、言葉は単なるコミュニケーションではなく、世界そのものを形づくる枠組みである。</p>
        <p>空間、行動、映像の表現がその変化を反映し、<span class="rb-concept-emphasis">言語＝世界の再構築</span>のプロセスが描かれる。</p>
      </div>
    </section>

    <section class="rb-chapter" aria-label="Rabbit, Habbit, Kubid">
      <div class="rb-chapter-gallery">
        <figure><OptimizedImage src={rabbit7} alt="Rabbit, Habbit, Kubid — Reconstructionの映像断片" /></figure>
        <div class="rb-chapter-gallery-bottom">
          <figure><OptimizedImage src={rabbit2} alt="映画の断片 2" /></figure>
          <figure><OptimizedImage src={rabbit3} alt="映画の断片 3" /></figure>
        </div>
      </div>
    </section>

    <section class="rb-chapter rb-chapter--behind" aria-label="Behind the film"><figure class="rb-behind"><OptimizedImage src={rabbitBehind} alt="Rabbit, Habbit, Kubidの制作風景" /></figure></section>
    <div class="project-next">
      <div class="project-next-project-row">
        <span class="project-next-kicker">他の作品</span>
        <a class="project-next-link" href="/what/real-copy" aria-label="Real Copy プロジェクトを見る">
          <span class="project-next-title">Real_Copy</span>
          <svg class="project-next-arrow" viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
            <path fill="currentColor" d="M4 2h6l10 10-10 10H4l10-10L4 2Z" />
          </svg>
        </a>
        <div class="project-next-gifs" aria-hidden="true">
          <OptimizedImage src={realCopyNext1} alt="" />
          <OptimizedImage src={realCopyNext2} alt="" />
          <OptimizedImage src={realCopyNext3} alt="" />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  import "../../scripts/next-project";
  document.querySelectorAll('.rb-soft-reveal').forEach((element) => {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      element.classList.add('is-in-view');
      observer.unobserve(element);
    }, { threshold: 0.35 });
    observer.observe(element);
  });

  const heroProse = document.querySelector('.rb-hero-prose');
  if (heroProse && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const textNodes = [...heroProse.querySelectorAll('p')].flatMap((element) =>
      [...element.childNodes].filter((node) => node.nodeType === Node.TEXT_NODE && node.textContent)
    );
    textNodes.forEach((node) => {
      const fragment = document.createDocumentFragment();
      [...(node.textContent ?? '')].forEach((character) => {
        const span = document.createElement('span');
        span.className = 'rb-visual-char';
        span.textContent = character;
        fragment.appendChild(span);
      });
      node.replaceWith(fragment);
    });

    const updateVisualLines = () => {
      const lineTops: number[] = [];
      heroProse.querySelectorAll<HTMLElement>('.rb-visual-char').forEach((character) => {
        const top = character.offsetTop;
        let lineIndex = lineTops.findIndex((lineTop) => Math.abs(lineTop - top) < 2);
        if (lineIndex === -1) {
          lineIndex = lineTops.length;
          lineTops.push(top);
        }
        character.style.setProperty('--line-delay', `${lineIndex * 90}ms`);
      });
    };
    heroProse.classList.add('is-line-motion-ready');
    updateVisualLines();
    document.fonts.ready.then(updateVisualLines);
    window.addEventListener('resize', updateVisualLines);
    const observer = new IntersectionObserver(([entry]) => {
      heroProse.classList.toggle('is-in-view', entry.isIntersecting);
    }, { threshold: 0.25 });
    observer.observe(heroProse);
  }
</script>
